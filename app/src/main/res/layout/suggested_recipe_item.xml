<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/srItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="15dp"
    android:padding="20dp"
    android:background="@drawable/rounded_full_border_green"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout
        android:id="@+id/sgItemGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        >




        <TextView
            android:id="@+id/srRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suggested Recipe Name"
            android:layout_marginBottom="5dp"
            android:textStyle="bold"
            android:textSize="17sp"
            />



        <TextView
            android:id="@+id/srIngredientCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4 ingredients · all in your pantry"
            />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>