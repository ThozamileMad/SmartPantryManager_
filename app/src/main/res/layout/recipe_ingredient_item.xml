<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/riItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/border_bottom"
    android:paddingBottom="10dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/riGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <TextView
        android:id="@+id/riName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Ingredient Name"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/riGuideline"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/riSeperator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:text="·"
        app:layout_constraintBaseline_toBaselineOf="@id/riName"
        app:layout_constraintStart_toEndOf="@id/riName" />

    <TextView
        android:id="@+id/riQuantityRequired"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quantity Required"
        app:layout_constraintBaseline_toBaselineOf="@id/riName"
        app:layout_constraintStart_toEndOf="@id/riSeperator" />

    <TextView
        android:id="@+id/riAvailableQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Have 5"
        app:layout_constraintBaseline_toBaselineOf="@id/riName"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>